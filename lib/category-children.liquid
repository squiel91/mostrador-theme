{%- liquid
  assign group = ''
  case parent.handle
    when 'congelados'
      assign group = 'carnes,pescados,verduras,pastas-y-pizzas,empanadas-y-tartas,helados,postres'
    when 'almacen'
      assign group = 'yerba-y-cafe,aceites,galletitas,arroz-y-fideos,conservas'
    when 'bebidas'
      assign group = 'aguas,refrescos,jugos'
  endcase
  assign handles = group | split: ','
-%}
{%- if parent.children.size > 0 -%}
  {%- for child in parent.children -%}<li><a href="{{ child.url }}">{% if icons %}{% render 'lib/category-icon', handle: child.handle, name: child.name, small: true %}{% endif %}{{ child.name }} <small>{{ child.productCount }}</small></a></li>{%- endfor -%}
{%- else -%}
  {%- for handle in handles -%}
    {%- assign child = collections | where: 'handle', handle | first -%}
    {%- if child -%}<li><a href="{{ child.url }}">{% if icons %}{% render 'lib/category-icon', handle: child.handle, name: child.name, small: true %}{% endif %}{{ child.name }} <small>{{ child.productCount }}</small></a></li>{%- endif -%}
  {%- endfor -%}
{%- endif -%}
