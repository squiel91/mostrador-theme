{% if collection.children.size > 0 %}<nav class="subchips" aria-label="Subcategorías"><a class="chip is-on" href="{{ collection.url }}">Todo<small>{{ collection.productTotals.totalCount }}</small></a>
  {% for child in collection.children %}<a class="chip" href="{{ child.url }}">{% render 'lib/category-icon', handle: child.handle, name: child.name %}{{ child.name }}<small>{{ child.productTotals.totalCount }}</small></a>{% endfor %}
</nav>{% endif %}
