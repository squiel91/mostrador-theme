{%- if products.size > 0 -%}<section class="{% if offers %}band-offers{% else %}section{% endif %}" aria-label="{{ title | escape }}"><div class="{% if offers %}wrap{% endif %}">
  <div class="sec-head"><div><h2>{{ title }}</h2>{% if offers %}<span class="countdown"><i class="ic ic-clock" aria-hidden="true"></i> {% render 'lib/constants', key: 'promotion_terms' %}</span>{% endif %}</div><div class="sec-tools">{% if url %}<a class="see-all" href="{{ url }}">{{ link_label | default: 'Ver todo' }}<i class="ic ic-arrow-right" aria-hidden="true"></i></a>{% endif %}<button class="rail-btn" type="button" data-rail="-1" aria-label="Anteriores"><i class="ic ic-chev-left" aria-hidden="true"></i></button><button class="rail-btn" type="button" data-rail="1" aria-label="Siguientes"><i class="ic ic-chev-right" aria-hidden="true"></i></button></div></div>
  <div class="rail">{% for p in products %}{% render 'lib/product-card', product: p %}{% endfor %}</div>
</div></section>{%- endif -%}
