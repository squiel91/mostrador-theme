{% assign page = data.page %}{% assign title = page.seo.title | default: page.title %}{% metadata title: title, description: page.seo.description %}
<div class="wrap"><nav class="crumbs" aria-label="Migas"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>Ayuda</span><span aria-hidden="true">/</span><span>{{ page.title }}</span></nav><div class="help"><aside class="help-side"><nav class="help-nav" aria-label="Ayuda">{% for item in data.helpPages.nodes %}<a class="chip{% if item.handle == page.handle %} is-on{% endif %}" href="{{ item.url }}"{% if item.handle == page.handle %} aria-current="page"{% endif %}><i class="ic {% if item.handle == 'envios-y-zonas' %}ic-truck{% else %}ic-help{% endif %}" aria-hidden="true"></i>{{ item.title }}</a>{% endfor %}</nav><div class="help-help"><b>¿No encontrás tu zona?</b><p class="muted">Escribinos y te decimos si llegamos.</p><a class="btn btn-wa btn-block" href="https://wa.me/{{ data.store.whatsappNumber | remove: '+' | remove: ' ' }}"><i class="ic ic-wa" aria-hidden="true"></i>Escribir por WhatsApp</a></div></aside><article class="help-body"><header><h1>{{ page.title }}</h1>{% if page.handle == 'envios-y-zonas' %}<p class="lead">Repartimos con camioneta propia y caja térmica, así los congelados llegan como salieron del freezer.</p>{% endif %}</header>
{% if page.template == 'envios' %}{% render './_snippets/template-page-envios' %}{% else %}{% render './_snippets/template-page-default', page: page %}{% endif %}
</article></div></div>
