{% metadata title: 'Buscar productos', robots: 'noindex' %}
<div class="wrap" data-catalog data-total="{{ data.results.totalCount }}"><nav class="crumbs" aria-label="Migas"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>Búsqueda</span></nav><header class="col-head"><h1>{% if request.query.q != blank %}Resultados para “{{ request.query.q | escape }}”{% else %}Buscar productos{% endif %}</h1><p class="count">{{ data.results.totalCount }} productos</p></header><form class="page-search" action="/busqueda"><label class="sr" for="page-query">Buscar productos</label><input id="page-query" type="search" name="q" value="{{ request.query.q | escape }}" placeholder="¿Qué estás buscando?"><button class="btn btn-primary" type="submit">Buscar</button></form>
<div class="grid-products section" data-grid>{% for product in data.results.nodes %}{% render 'lib/product-card', product: product %}{% else %}<div class="empty-state"><h2>No encontramos productos.</h2><p>Probá con otro nombre o recorré las categorías.</p><a class="btn btn-outline" href="{{ data.catalogSummary.url }}">Ver todos los productos</a></div>{% endfor %}</div>
{% capture suffix %}&q={{ request.query.q | url_encode }}{% if request.query.sort %}&sort={{ request.query.sort | url_encode }}{% endif %}{% if request.query.available %}&available=true{% endif %}{% endcapture %}{% render 'lib/pager', info: data.results.pageInfo, total: data.results.totalCount, url: '/busqueda', query_string: suffix %}
</div>
