{% metadata title: data.store.name, description: data.store.description %}
<div class="wrap"><section class="section" aria-label="Promociones" style="padding-top:12px">
    <div class="hero">
      <a class="banner banner--main" href="{{ data.offers.url }}">
        <figure class="media only-desk" style="--ar:3"><img src="http://localhost:8787/tiendu/images/5ec5cac3-d44f-4a1c-ae9f-c813fe0d416c/original.svg" alt="" loading="lazy"></figure><figure class="media only-mob" style="--ar:1.3333333333333333"><img src="http://localhost:8787/tiendu/images/b1f45331-2ec3-4a1d-af5f-21da9a43fe6f/original.svg" alt="" loading="lazy"></figure>
        <div class="banner-body">
          <span class="banner-eyebrow"><i class="ic ic-percent" aria-hidden="true"></i> Ofertas de la semana</span>
          <h2 class="banner-title">Papas prefritas de 2,5 kg a {{ data.headerPromo.priceMinInCents | money: data.headerPromo.currency }}.</h2>
          <p class="banner-text">Corte clásico, al horno o en freidora de aire. {% render 'lib/constants', key: 'promotion_terms' %}.</p>
          <span class="btn btn-primary">Ver ofertas <i class="ic ic-arrow-right" aria-hidden="true"></i></span>
        </div>
        <span class="tag-price"><b>{{ data.headerPromo.priceMinInCents | money: data.headerPromo.currency }}</b><s>antes {{ data.headerPromo.compareAtPriceInCents | money: data.headerPromo.currency }}</s></span>
      </a>
      <a class="banner banner--sm banner--dark" href="{{ data.featuredFish.url }}">
        <figure class="media only-desk media--dark" style="--ar:3"><img src="http://localhost:8787/tiendu/images/3401d2a9-8eb3-4b9e-8e69-afa8187698e4/original.svg" alt="" loading="lazy"></figure><figure class="media only-mob media--dark" style="--ar:1.3333333333333333"><img src="http://localhost:8787/tiendu/images/dbb1f09a-0fb6-41ed-88d9-f797d4a22c41/original.svg" alt="" loading="lazy"></figure>
        <div class="banner-body">
          <span class="banner-eyebrow"><i class="ic ic-fish" aria-hidden="true"></i> Pescados</span>
          <h2 class="banner-title">Merluza en medallones, {{ data.featuredFish.priceMinInCents | money: data.featuredFish.currency }}.</h2>
          <p class="banner-text">Sin espinas, del freezer a la sartén.</p>
          <span class="btn btn-accent">Ver pescados</span>
        </div>
      </a>
      <a class="banner banner--sm" href="{{ data.shippingPage.url }}">
        <figure class="media only-desk" style="--ar:3"><img src="http://localhost:8787/tiendu/images/73443f4d-9e20-4fd8-8466-9e4d89b4ee1a/original.svg" alt="" loading="lazy"></figure><figure class="media only-mob" style="--ar:1.3333333333333333"><img src="http://localhost:8787/tiendu/images/e25c3b4a-2ea4-4a76-8282-e922b2f61550/original.svg" alt="" loading="lazy"></figure>
        <div class="banner-body">
          <span class="banner-eyebrow"><i class="ic ic-truck" aria-hidden="true"></i> Envío en el día</span>
          <h2 class="banner-title">Pedí antes de las {% render 'lib/constants', key: 'delivery_cutoff_hour' %} h y te llega hoy.</h2>
          <p class="banner-text">{% render 'lib/constants', key: 'montevideo_name' %}, {% render 'lib/constants', key: 'delivery_days' %}.</p>
          <span class="btn btn-ink">Ver zonas</span>
        </div>
      </a>
    </div>
  </section>


<section class="section" aria-labelledby="cats-t"><div class="sec-head"><h2 id="cats-t">Comprá por categoría</h2><a class="see-all" href="{{ data.catalogSummary.url }}">Todas<i class="ic ic-arrow-right" aria-hidden="true"></i></a></div>
  <nav class="cats" aria-label="Categorías">{% assign tile_handles = 'carnes,pescados,verduras,pastas-y-pizzas,helados,yerba-y-cafe,aceites,ofertas' | split: ',' %}{% for handle in tile_handles %}{% assign c = data.navigationCollections.nodes | where: 'handle', handle | first %}{% if c %}<a class="cat-tile" href="{{ c.url }}">{% render 'lib/category-icon', handle: handle, name: c.name %}<b>{{ c.name }}</b><small>{{ c.productTotals.totalCount }} productos</small></a>{% endif %}{% endfor %}</nav>
</section></div>
{% render 'lib/product-row', products: data.offers.products.nodes, title: 'Ofertas de la semana.', offers: true, url: data.offers.url, link_label: 'Ver todas las ofertas' %}
<div class="wrap"><section class="section" aria-labelledby="best-t"><div class="sec-head"><h2 id="best-t">Más vendidos</h2><a class="see-all" href="{{ data.catalogSummary.url }}">Ver todo<i class="ic ic-arrow-right" aria-hidden="true"></i></a></div><div class="grid-products">{% for product in data.bestSellers.nodes %}{% render 'lib/product-card', product: product %}{% endfor %}</div></section>
{% render 'lib/product-row', products: data.frozen.products.nodes, title: data.frozen.name, url: data.frozen.url, link_label: 'Ver Congelados' %}
{% render 'lib/product-row', products: data.pantry.products.nodes, title: data.pantry.name, url: data.pantry.url, link_label: 'Ver Almacén' %}
<section class="section" id="como-comprar" aria-labelledby="how-t">
    <div class="howto">
      <h2 id="how-t">Hacé el surtido sin salir de casa.</h2>
      <ol class="steps">
        <li class="step"><span class="step-n">1</span><div><b>Elegí</b><p>Sumá desde la lista con el +, sin entrar a cada producto.</p></div></li>
        <li class="step"><span class="step-n">2</span><div><b>Pagá con Mercado Pago</b><p>Tarjetas, Redpagos o Abitab. Si retirás, también en efectivo.</p></div></li>
        <li class="step"><span class="step-n">3</span><div><b>Recibí o retirá</b><p>{% render 'lib/constants', key: 'montevideo_name' %}: {% render 'lib/constants', key: 'montevideo_delivery' %}. {% render 'lib/constants', key: 'coast_name' %}: {% render 'lib/constants', key: 'coast_delivery' %}. O en el local en {% render 'lib/constants', key: 'pickup_ready_hours' %} h.</p></div></li>
      </ol>
      <div class="howto-foot">
        <span><i class="ic ic-clock" aria-hidden="true"></i> Franjas de entrega: {% render 'lib/constants', key: 'delivery_weekday_slots' %}</span>
        <span><i class="ic ic-receipt" aria-hidden="true"></i> Compra mínima para envío: {% render 'lib/constants', key: 'delivery_minimum_cents', format: 'money' %}</span>
        <a class="link" href="{{ data.shippingPage.url }}">Ver zonas y costos</a>
      </div>
    </div>
  </section>

  <section class="section" aria-label="Beneficios">
    <ul class="benefits">
      <li class="benefit"><i class="ic ic-truck" aria-hidden="true"></i><div><b>Envío gratis desde {% render 'lib/constants', key: 'montevideo_free_shipping_cents', format: 'money' %}</b><p>En {% render 'lib/constants', key: 'montevideo_name' %}. {% render 'lib/constants', key: 'coast_name' %} desde {% render 'lib/constants', key: 'coast_free_shipping_cents', format: 'money' %}.</p></div></li>
      <li class="benefit"><i class="ic ic-store" aria-hidden="true"></i><div><b>Retiro sin costo</b><p>En {% render 'lib/constants', key: 'pickup_locations' %}, listo en {% render 'lib/constants', key: 'pickup_ready_hours' %} horas.</p></div></li>
      <li class="benefit"><i class="ic ic-receipt" aria-hidden="true"></i><div><b>Mínimo {% render 'lib/constants', key: 'delivery_minimum_cents', format: 'money' %} para envío</b><p>Si retirás en el local, no hay mínimo.</p></div></li>
      <li class="benefit"><i class="ic ic-users" aria-hidden="true"></i><div><b>Mayorista por WhatsApp</b><p>Para restoranes y almacenes: pedí la lista.</p></div></li>
    </ul>
  </section>

  <section class="section" aria-labelledby="loc-t">
    <div class="sec-head"><h2 id="loc-t">Nuestros locales</h2></div>
    <div class="stores">
      <article class="store"><p class="store-name"><i class="ic ic-pin" aria-hidden="true"></i> {% render 'lib/constants', key: 'blanqueada_name' %} <span class="store-open">{% render 'lib/constants', key: 'store_status' %}</span></p>
        <dl><dt>Dirección</dt><dd>{% render 'lib/constants', key: 'blanqueada_address' %}</dd><dt>{% render 'lib/constants', key: 'store_weekdays' %}</dt><dd>{% render 'lib/constants', key: 'store_weekday_hours' %}</dd><dt>Domingo</dt><dd>{% render 'lib/constants', key: 'blanqueada_sunday_hours' %}</dd></dl>
        <div class="store-actions"><a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&amp;query={% render 'lib/constants', key: 'blanqueada_map_query' %}" target="_blank" rel="noopener"><i class="ic ic-pin" aria-hidden="true"></i> Cómo llegar</a><a class="btn btn-outline" href="tel:{% render 'lib/constants', key: 'store_phone' %}"><i class="ic ic-phone" aria-hidden="true"></i> Llamar</a></div></article>
      <article class="store"><p class="store-name"><i class="ic ic-pin" aria-hidden="true"></i> {% render 'lib/constants', key: 'solymar_name' %} <span class="store-open">{% render 'lib/constants', key: 'store_status' %}</span></p>
        <dl><dt>Dirección</dt><dd>{% render 'lib/constants', key: 'solymar_address' %}</dd><dt>{% render 'lib/constants', key: 'store_weekdays' %}</dt><dd>{% render 'lib/constants', key: 'store_weekday_hours' %}</dd><dt>Domingo</dt><dd>{% render 'lib/constants', key: 'solymar_sunday_hours' %}</dd></dl>
        <div class="store-actions"><a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&amp;query={% render 'lib/constants', key: 'solymar_map_query' %}" target="_blank" rel="noopener"><i class="ic ic-pin" aria-hidden="true"></i> Cómo llegar</a><a class="btn btn-outline" href="tel:{% render 'lib/constants', key: 'store_phone' %}"><i class="ic ic-phone" aria-hidden="true"></i> Llamar</a></div></article>
      <article class="store store--info"><p class="store-name"><i class="ic ic-box" aria-hidden="true"></i> Retiro en el local</p>
        <p class="small muted">Comprás online y pasás a buscarlo. Te avisamos por WhatsApp cuando está listo, en {% render 'lib/constants', key: 'pickup_ready_hours' %} horas en horario de local. Lo guardamos en freezer hasta {% render 'lib/constants', key: 'pickup_hold_hours' %} h.</p>
        <div class="store-actions"><a class="btn btn-outline" href="{{ data.shippingPage.url }}">Más sobre el retiro</a></div></article>
    </div>
  </section>
</div>
