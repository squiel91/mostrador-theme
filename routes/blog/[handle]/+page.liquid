{%- liquid
  assign post = data.post
  assign title = post.seo.title | default: post.title
  assign more = data.morePosts.nodes | where_exp: 'p', 'p.handle != post.handle'
  assign handles = ''
  case post.handle
    when 'milanesas-al-horno'
      assign handles = 'milanesas-de-pollo-rebozadas,papas-prefritas-corte-clasico'
    when 'cuanto-dura-cada-cosa-en-el-freezer'
      assign handles = 'medallones-de-merluza,milanesas-de-pollo-rebozadas,empanadas-para-horno-x-12'
    when 'empanadas-congeladas'
      assign handles = 'empanadas-para-horno-x-12'
  endcase
  assign recipe_handles = handles | split: ','
-%}
{% metadata title: title, description: post.seo.description, image: post.coverImage.url %}
<div class="wrap"><nav class="crumbs" aria-label="Migas"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/blog">Recetas y consejos</a><span aria-hidden="true">/</span><span>{{ post.title }}</span></nav>
<header class="art-head"><p class="post-meta"><span class="post-tag challenge-differed" data-challenge="blog-categories">{% if post.handle == 'cuanto-dura-cada-cosa-en-el-freezer' %}Consejos{% else %}Receta{% endif %}</span><time datetime="{{ post.publishedAt }}">{{ post.publishedAt | date: '%e de %B de %Y' }}</time></p><h1>{{ post.title }}</h1><p class="lead">{{ post.excerpt }}</p>{% if post.handle == 'milanesas-al-horno' %}<div class="recipe-facts challenge-differed" data-challenge="recipe-metadata"><span><i class="ic ic-clock" aria-hidden="true"></i>25 min</span><span><i class="ic ic-users" aria-hidden="true"></i>4 porciones</span><span><i class="ic ic-flame" aria-hidden="true"></i>Horno a 220 °C</span></div>{% endif %}</header>
<div class="art-layout">{% if handles != blank %}<aside class="uses challenge-differed" data-challenge="shoppable-recipes" aria-labelledby="uses-t"><h2 id="uses-t">Lo que usamos</h2>{% assign total = 0 %}{% for handle in recipe_handles %}{% assign p = data.recipeProducts.nodes | where: 'handle', handle | first %}{% if p %}{% assign total = total | plus: p.priceMinInCents %}<div class="uses-item"><a href="{{ p.url }}"><figure class="media" style="--ar:1 / 1"><img src="{{ p.coverImage | image_url: width: 200 }}" alt="{{ p.title | escape }}" loading="lazy"></figure></a><div><b><a href="{{ p.url }}">{{ p.title }}</a></b><span class="card-pres">{% render 'lib/presentation', product: p, variant: p.variants.first %}</span><p class="price"><strong>{{ p.priceMinInCents | money: p.currency }}</strong></p></div><button class="btn btn-primary" type="button" disabled><i class="ic ic-plus" aria-hidden="true"></i>Agregar</button></div>{% endif %}{% endfor %}<div class="uses-total"><button class="btn btn-primary btn-block" type="button" disabled><i class="ic ic-cart" aria-hidden="true"></i>Agregar {% if recipe_handles.size == 2 %}los dos{% else %}todo{% endif %} · {{ total | money }}</button></div></aside>{% endif %}
<div class="art-body">{% if post.coverImage %}<div class="art-cover"><figure class="media" style="--ar:16 / 9"><img src="{{ post.coverImage | image_url: width: 1400 }}" alt="{{ post.coverImage.alt | default: post.title | escape }}" width="1400" height="788"></figure></div>{% endif %}{{ post.html }}</div></div>
{% if more.size > 0 %}<section class="section"><div class="sec-head"><h2>Más notas</h2><a class="see-all" href="/blog">Ver todas<i class="ic ic-arrow-right" aria-hidden="true"></i></a></div><div class="post-grid">{% for p in more limit: 3 %}{% render 'lib/post-card', post: p %}{% endfor %}</div></section>{% endif %}
</div>
